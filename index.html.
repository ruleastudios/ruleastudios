<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Rulea — Style • Sculpt • Unwind</title>
  <meta name="description" content="Minimal objects for a maximal life. Elevated tools and wearables that help you reset — from studio to street to sleep." />
  <style>
    :root{
      --bg:#FAF8F6;
      --text:#111;
      --muted:#8A8175;
      --accent:#5C4A3E;
      --card:#fff;
      --line:rgba(0,0,0,.08);
      --shadow:0 6px 18px rgba(0,0,0,.06);
      --radius:16px;
    }
    *{box-sizing:border-box}
    html,body{margin:0;padding:0;background:var(--bg);color:var(--text);font-family:Inter,ui-sans-serif,system-ui,Segoe UI,Roboto,Helvetica,Arial,Apple Color Emoji,Segoe UI Emoji}
    a{color:inherit;text-decoration:none}
    .wrap{max-width:1100px;margin:0 auto;padding:0 16px}
    .chip{display:inline-block;border:1px solid var(--line);border-radius:999px;padding:4px 10px;font-size:12px;color:#333;background:#fff}
    .btn{display:inline-block;border-radius:999px;padding:12px 18px;border:1px solid var(--text);background:var(--text);color:#fff;font-weight:600;cursor:pointer}
    .btn.outline{background:transparent;color:var(--text)}
    header{position:sticky;top:0;backdrop-filter:saturate(140%) blur(8px);border-bottom:1px solid var(--line);background:rgba(250,248,246,.7);z-index:30}
    .nav{height:64px;display:flex;align-items:center;justify-content:space-between}
    .brand{letter-spacing:.2em;font-weight:700;font-size:12px}
    .nav a{font-size:14px;opacity:.9;margin:0 8px}
    .hero{padding:64px 0;border-bottom:1px solid var(--line)}
    .grid{display:grid;gap:24px}
    .grid-2{grid-template-columns:1.1fr .9fr}
    .h1{font-size:48px;line-height:1.05;margin:8px 0 12px}
    .lead{font-size:18px;color:#333;max-width:48ch}
    .note{display:flex;gap:8px;align-items:center;color:#555;font-size:14px;margin-top:12px}
    .imggrid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
    .ph{aspect-ratio:4/3;border-radius:16px;background:linear-gradient(145deg,#e8e4df,#fcfbf9);box-shadow:inset 0 0 0 1px var(--line);display:flex;align-items:flex-end;padding:12px;color:#555}
    .section{padding:64px 0}
    .section h2{font-size:32px;margin:0 0 16px}
    .card{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow)}
    .card .inner{padding:18px}
    .products{grid-template-columns:repeat(auto-fit,minmax(260px,1fr))}
    .chips{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:8px}
    .actions{display:flex;gap:10px;align-items:center;margin-top:8px}
    .muted{color:var(--muted)}
    .features{grid-template-columns:repeat(auto-fit,minmax(220px,1fr))}
    /* Tabs */
    .tabs{margin-top:16px}
    .tablist{display:flex;gap:8px;flex-wrap:wrap}
    .tablist button{border:1px solid var(--line);background:#fff;border-radius:999px;padding:8px 14px;cursor:pointer}
    .tablist button[aria-selected="true"]{background:var(--text);color:#fff}
    .tabpanel{display:none;margin-top:12px}
    .tabpanel.active{display:block}
    ul.specs{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:8px;padding:0;margin:0;list-style:none}
    ul.specs li{display:flex;gap:10px;align-items:center;padding:10px 12px;background:#fff;border:1px solid var(--line);border-radius:12px}
    /* Accordion */
    .accordion-item{border:1px solid var(--line);border-radius:12px;background:#fff}
    .accordion-item + .accordion-item{margin-top:10px}
    .accordion-button{width:100%;text-align:left;padding:14px 16px;background:transparent;border:0;font-weight:600;cursor:pointer}
    .accordion-content{display:none;padding:0 16px 16px;color:#333}
    /* Join */
    .join{ text-align:center }
    .email{border:1px solid var(--line);border-radius:999px;padding:12px 14px;width:100%;max-width:380px}
    footer{border-top:1px solid var(--line);padding:24px 0;margin-top:24px}
    @media (max-width:900px){
      .grid-2{grid-template-columns:1fr}
      .h1{font-size:36px}
    }
  </style>
</head>
<body>
  <header>
    <div class="wrap nav">
      <div style="display:flex;align-items:center;gap:8px">
        <div style="width:28px;height:28px;border-radius:999px;background:#111"></div>
        <span class="brand">RULEA</span>
      </div>
      <nav>
        <a href="#products">Products</a>
        <a href="#philosophy">Philosophy</a>
        <a href="#materials">Materials</a>
        <a href="#faq">FAQ</a>
      </nav>
      <a class="btn outline" href="#join">Join Waitlist</a>
    </div>
  </header>

  <section class="hero">
    <div class="wrap grid grid-2" style="align-items:center">
      <div>
        <div class="muted" style="letter-spacing:.25em;font-size:12px;margin-bottom:10px">LOS ANGELES</div>
        <h1 class="h1">Style • Sculpt • Unwind</h1>
        <p class="lead">Minimal objects for a maximal life. Elevated tools and wearables that help you reset — from studio to street to sleep.</p>
        <div class="actions" style="margin-top:18px">
          <a class="btn" href="#products">Shop the first drop</a>
          <a class="btn outline" href="#join">Get launch email</a>
        </div>
        <div class="note"><span>✅</span><span>Embossed branding. Non‑toxic materials. Designed in LA.</span></div>
      </div>
      <div class="imggrid">
        <div class="ph">HERO — Sleep Eye Mask + Box</div>
        <div class="ph">Travel Organizer — 5 pack</div>
        <div class="ph">Peanut Yoga Ball — one‑side emboss</div>
        <div class="ph">Knit Legwarmers — leather tag</div>
      </div>
    </div>
  </section>

  <section id="products" class="section">
    <div class="wrap">
      <h2>Objects to reset body + mind</h2>
      <div class="grid products">
        <div class="card"><div class="inner">
          <div class="chips"><span class="chip">Rest</span><span class="chip">Blackout</span><span class="chip">No‑slip</span></div>
          <h3>Sleep Eye Mask</h3>
          <div class="ph" style="margin:10px 0">Mask with minimal box</div>
          <p>Zero‑pressure, blackout mask with plush contour. Subtle RULEA emboss on the strap. Ships in a recyclable, unbranded box.</p>
          <div class="actions"><a class="btn" href="#join">Notify me</a><a class="btn outline" href="#">Details</a></div>
        </div></div>

        <div class="card"><div class="inner">
          <div class="chips"><span class="chip">Flow</span><span class="chip">Set of 5</span><span class="chip">Matte nylon</span></div>
          <h3>Travel Organizer — 5 Pack</h3>
          <div class="ph" style="margin:10px 0">5 zip cubes • matte nylon</div>
          <p>Modular packing cubes with matte nylon and soft structure. Embossed RULEA patch. Five sizes for weekends to long hauls.</p>
          <div class="actions"><a class="btn" href="#join">Notify me</a><a class="btn outline" href="#">Details</a></div>
        </div></div>

        <div class="card"><div class="inner">
          <div class="chips"><span class="chip">Sculpt</span><span class="chip">Firm EVA</span></div>
          <h3>Yoga Peanut Ball</h3>
          <div class="ph" style="margin:10px 0">Firm EVA • one‑side emboss</div>
          <p>Targeted mobility tool for spine decompression and posterior chain. Branding is embossed on one side only.</p>
          <div class="actions"><a class="btn" href="#join">Notify me</a><a class="btn outline" href="#">Details</a></div>
        </div></div>

        <div class="card"><div class="inner">
          <div class="chips"><span class="chip">Warmth</span><span class="chip">Neutral tones</span></div>
          <h3>Knit Legwarmers</h3>
          <div class="ph" style="margin:10px 0">Nude / Cream / Brown</div>
          <p>Studio‑to‑street legwarmers in neutral tones. Finished with a small leather tag embossed with RULEA.</p>
          <div class="actions"><a class="btn" href="#join">Notify me</a><a class="btn outline" href="#">Details</a></div>
        </div></div>
      </div>
    </div>
  </section>

  <section id="philosophy" class="section">
    <div class="wrap">
      <h2>Quiet luxury, daily utility</h2>
      <div class="grid features">
        <div class="card"><div class="inner">
          <h4>Design that disappears</h4>
          <p class="muted">Minimal lines, neutral palette, details you feel more than you see.</p>
        </div></div>
        <div class="card"><div class="inner">
          <h4>Considered materials</h4>
          <p class="muted">Non‑toxic where it counts. Durable without the shouty logos.</p>
        </div></div>
        <div class="card"><div class="inner">
          <h4>Built to last</h4>
          <p class="muted">Stitching, density, and hardware tuned for daily rituals — not landfill.</p>
        </div></div>
      </div>
    </div>
  </section>

  <section id="materials" class="section">
    <div class="wrap">
      <h2>Tactility first. Specs that matter.</h2>
      <div class="tabs">
        <div role="tablist" aria-label="Specs" class="tablist">
          <button role="tab" aria-selected="true" aria-controls="tab-mask" id="tab-btn-mask">Eye Mask</button>
          <button role="tab" aria-selected="false" aria-controls="tab-organizers" id="tab-btn-organizers">Organizers</button>
          <button role="tab" aria-selected="false" aria-controls="tab-peanut" id="tab-btn-peanut">Peanut Ball</button>
          <button role="tab" aria-selected="false" aria-controls="tab-legwarmers" id="tab-btn-legwarmers">Legwarmers</button>
        </div>
        <div id="tab-mask" class="tabpanel active" role="tabpanel" aria-labelledby="tab-btn-mask">
          <ul class="specs">
            <li>Plush blackout foam; zero‑pressure bridge</li>
            <li>Adjustable strap, subtle RULEA emboss</li>
            <li>Skin‑friendly knit; machine‑washable cover</li>
            <li>Ships in unbranded recyclable box</li>
          </ul>
        </div>
        <div id="tab-organizers" class="tabpanel" role="tabpanel" aria-labelledby="tab-btn-organizers">
          <ul class="specs">
            <li>Set of 5 sizes (XS–XL)</li>
            <li>Soft‑structure walls, smooth zips</li>
            <li>Matte nylon; embossed RULEA patch</li>
            <li>Flat‑pack storage; wipe‑clean</li>
          </ul>
        </div>
        <div id="tab-peanut" class="tabpanel" role="tabpanel" aria-labelledby="tab-btn-peanut">
          <ul class="specs">
            <li>Firm EVA density for mobility work</li>
            <li>One‑side only embossed branding</li>
            <li>Non‑slip micro‑texture</li>
            <li>Sweat‑resistant, easy‑clean</li>
          </ul>
        </div>
        <div id="tab-legwarmers" class="tabpanel" role="tabpanel" aria-labelledby="tab-btn-legwarmers">
          <ul class="specs">
            <li>Neutral tones: Nude / Cream / Brown</li>
            <li>Rib knit, over‑the‑knee</li>
            <li>Leather micro‑tag embossed RULEA</li>
            <li>Durable yarn; soft hand feel</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section id="faq" class="section">
    <div class="wrap">
      <h2>Common questions</h2>
      <div class="accordion">
        <div class="accordion-item">
          <button class="accordion-button">When can I buy?</button>
          <div class="accordion-content">First drop is in production. Join the waitlist for early access and launch pricing.</div>
        </div>
        <div class="accordion-item">
          <button class="accordion-button">Is the branding loud?</button>
          <div class="accordion-content">No. Emboss only. On the peanut ball it’s one‑side; on textiles it’s a small leather tag.</div>
        </div>
        <div class="accordion-item">
          <button class="accordion-button">Sustainability?</button>
          <div class="accordion-content">We design for long life, repairability where possible, and recyclable packaging.</div>
        </div>
        <div class="accordion-item">
          <button class="accordion-button">Returns?</button>
          <div class="accordion-content">Simple 30‑day returns on non‑used items once the store opens.</div>
        </div>
      </div>
    </div>
  </section>

  <section id="join" class="section join">
    <div class="wrap">
      <h2>Be part of Drop 01</h2>
      <p class="muted">Leave your email to get the launch date and a one‑time code.</p>
      <!-- To make this work without code, swap the form action with a Mailchimp or Formspree endpoint -->
      <form action="https://formspree.io/f/your-id-here" method="POST" onsubmit="alert('Thanks! You\\'re on the list.');">
        <input class="email" type="email" name="email" placeholder="you@example.com" required />
        <div class="actions" style="justify-content:center;margin-top:10px">
          <button class="btn" type="submit">Join Waitlist</button>
        </div>
      </form>
    </div>
  </section>

  <footer>
    <div class="wrap" style="display:flex;align-items:center;justify-content:space-between;gap:12px;flex-wrap:wrap">
      <div style="display:flex;align-items:center;gap:8px">
        <div style="width:22px;height:22px;border-radius:999px;background:#111"></div>
        <span class="brand">RULEA</span>
      </div>
      <div class="muted" style="font-size:12px">© <span id="year"></span> Rulea Los Angeles — Style • Sculpt • Unwind</div>
      <div style="display:flex;gap:10px;font-size:12px">
        <a href="#">Instagram</a>
        <a href="#">TikTok</a>
        <a href="#">Contact</a>
      </div>
    </div>
  </footer>

  <script>
    // Year
    document.getElementById('year').textContent = new Date().getFullYear();

    // Tabs
    const tabButtons = document.querySelectorAll('[role=tab]');
    const panels = document.querySelectorAll('.tabpanel');
    tabButtons.forEach(btn => {
      btn.addEventListener('click', () => {
        tabButtons.forEach(b => b.setAttribute('aria-selected','false'));
        panels.forEach(p => p.classList.remove('active'));
        btn.setAttribute('aria-selected','true');
        const panel = document.getElementById(btn.getAttribute('aria-controls'));
        panel.classList.add('active');
      });
    });

    // Accordion
    document.querySelectorAll('.accordion-button').forEach(btn => {
      btn.addEventListener('click', () => {
        const content = btn.nextElementSibling;
        content.style.display = content.style.display === 'block' ? 'none' : 'block';
      });
    });
  </script>
</body>
</html>
